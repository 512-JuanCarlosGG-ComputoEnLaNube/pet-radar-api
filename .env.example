# Copiar a .env y configurar las credenciales locales.
MAILER_SERVICE=Gmail
MAILER_USER=your-email@example.com
MAILER_PASSWORD=your-app-password
MAPBOX_TOKEN=your-mapbox-token

DB_PASSWORD=change-this-local-password
DB_NAME=petradardb
DB_USER=postgres
# Para ejecutar Nest fuera de Docker. Compose usa el servicio postgres.
DB_HOST=localhost
DB_PORT=5432
DB_TYPE=postgres
DB_MIGRATIONS_RUN=false

# Para ejecutar Nest fuera de Docker. Compose usa el servicio redis.
REDIS_HOST=localhost
REDIS_PORT=6379

# Puertos publicados en tu computadora.
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PUBLISHED_PORT=6379
